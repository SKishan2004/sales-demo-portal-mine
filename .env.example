# ==============================================================================
# Mobileum Sales Demo Portal — Environment Configuration Template
# Copy to .env and replace placeholder values before running or deploying.
# Never commit real secrets or .env into Git.
# ==============================================================================

NODE_ENV=development
PORT=4000

# PostgreSQL Connection (separate service — local, Docker, or internal DB server)
DATABASE_URL=postgresql://mobileum_demo:replace_with_strong_db_password@localhost:5432/mobileum_sales_demo
PG_POOL_MAX=20

# Persistent Media Storage (use an absolute path outside dist/ in production)
MEDIA_STORAGE_DIR=./storage
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=500

# Session & Cookie Security
# Generate SESSION_SECRET with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_at_least_64_chars
SESSION_TTL_HOURS=12
PREVIEW_TOKEN_TTL_MINUTES=15
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# One-Time Super Admin Bootstrap Seed (consumed by npm run db:seed)
ADMIN_SEED_NAME=Platform Super Admin
ADMIN_SEED_EMAIL=superadmin@mobileum.internal
ADMIN_SEED_USERNAME=superadmin
ADMIN_SEED_PASSWORD=
